# AI
GROQ_API_KEY=your_groq_api_key

# Zoho OAuth
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REDIRECT_URI=http://localhost:3001/auth/callback
# On Vercel, set ZOHO_REDIRECT_URI=https://your-app.vercel.app/auth/callback

# Zoho Books
ZOHO_ORG_ID=your_zoho_org_id

# Database (PostgreSQL — optional, app runs without it)
DATABASE_URL=postgresql://user:password@localhost:5432/ceo_intelligence

# Auth
JWT_SECRET=your_jwt_secret_here_min_32_chars
ENCRYPTION_KEY=your_32_char_aes_key_here_padded

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173
