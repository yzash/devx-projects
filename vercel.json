{
  "version": 2,
  "buildCommand": "cd myfirst-demo && npm install && npm run build",
  "outputDirectory": "myfirst-demo/dist",
  "installCommand": "npm install",
  "functions": {
    "api/chat.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
